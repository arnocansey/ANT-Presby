# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=antpress
DB_USER=postgres
DB_PASSWORD=your_password_here
# Optional: preferred by Prisma
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/antpress?schema=public

# Server Configuration
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# JWT Configuration
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
# Optional: signs Google OAuth state (falls back to JWT_SECRET)
OAUTH_STATE_SECRET=
REFRESH_TOKEN_EXPIRATION=30d
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token

# CORS Configuration
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:5000
# Optional comma-separated allowlist for additional web origins, previews, or staging.
# FRONTEND_URL, APP_BASE_URL and CORS_ORIGINS are also the only web origins OAuth and payment callbacks may redirect to.
CORS_ORIGINS=

# Shared with the frontend's PROXY_SHARED_SECRET so rate limiting sees real visitor IPs behind the Next.js proxy
PROXY_SHARED_SECRET=

# Google OAuth (Google sign-in is rejected unless at least one client ID is set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_ALLOWED_CLIENT_IDS=
MOBILE_APP_SCHEME=antpressmobile

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=ANT PRESS <no-reply@yourdomain.com>

# Payment Gateway - Paystack (required in production; without it payments are mocked in development only)
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
PRISMA_CONNECTION_LIMIT=15
PRISMA_POOL_TIMEOUT=30

# Optional bootstrap admin for npm run seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
SEED_ADMIN_PHONE=

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Per-client limit for login/register/resend-verification/Google sign-in (per 15 minutes)
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Optional: Expo access token for push notifications (only if "Enhanced Push Security" is enabled in Expo).
# Set the real value in the Render dashboard; never commit it.
EXPO_ACCESS_TOKEN=
